pipeline {
  agent {
    label 'deb13-amd64'
  }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 180, unit: 'MINUTES')
  }

  environment {
    BRANCH = "{{version}}"
    S3_HOST = "${params.S3_HOST}"
    S3_BUCKET = "${params.S3_BUCKET}"
    S3_BASE_DIR = "${params.S3_BASE_DIR}"
    S3_HTTP_BUCKET_URL = "${params.S3_HTTP_BUCKET_URL}"
  }

  stages {
    stage('Build kernel') {
      steps {
        build(
          job: 'system_tests_build_kernel_and_modules',
          parameters: [
            string(name: 'BUILD_DEVICE', value: 'baremetal'),
            string(name: 'KERNEL_COMMIT_ID', value: "${params.KERNEL_COMMIT_ID}"),
            string(name: 'LTTNG_MODULES_COMMIT_ID', value: '0be94330d9e0bd2f6fffa4c54ece0677a9a64b59'),
          ]
        )
      }
    }

    stage('Setup') {
      steps {
        cleanWs()

        dir('src/babeltrace') {
          checkout([$class: 'GitSCM', branches: [[name: "{{version}}"]], userRemoteConfigs: [[url: "https://github.com/efficios/babeltrace.git"]]])
        }

        dir('src/lttng-ci') {
          checkout([$class: 'GitSCM', branches: [[name: "${params.LTTNG_CI_BRANCH}"]], userRemoteConfigs: [[url: "${params.LTTNG_CI_REPO}"]]])

          sh(
            label: 'Setup venv',
            script: """#!/usr/bin/bash -x
rm -rf venv/
python3 -m virtualenv venv
source venv/bin/activate
pip3 install -r scripts/babeltrace-benchmark/requirement.txt
""",
          )
        }
      }
    }

    stage('Launch LAVA job(s)') {
      when {
        expression {
          env.BENCHMARK_SKIP_SUBMISSION != "true"
        }
      }

      environment {
        LAVA2_JENKINS_TOKEN = credentials('jenkins_lava2_key')
        S3_KEY = credentials('s3_obj_lava_key')
      }

      steps {
        sh('env')
        dir('src/lttng-ci') {
          sh(
            label: "launch jobs",
            script: """#!/usr/bin/bash -x
source venv/bin/activate
FORCE_ARG=''
if [[ \$BENCHMARK_FORCE == "true" ]]; then
  FORCE_ARG="--force-jobs"
fi

python3 scripts/babeltrace-benchmark/benchmark.py \
  --generate-regression-jobs \
  --bt-repo-path \$WORKSPACE/src/babeltrace \
  --ci-repo \$LTTNG_CI_REPO \
  --ci-branch \$LTTNG_CI_BRANCH \
  --nfs-root-url \$NFS_ROOT_URL \
  --kernel-url \$S3_HTTP_BUCKET_URL/system-tests/kernel/\$KERNEL_COMMIT_ID.baremetal.bzImage \
  --batch-size 0 \
  \$FORCE_ARG
""",
          )
        }
      }
    }

    stage('Compare result(s)') {
      environment {
        LAVA2_JENKINS_TOKEN = credentials('jenkins_lava2_key')
        S3_KEY = credentials('s3_obj_lava_key')
      }

      steps {
        dir('src/lttng-ci') {
          sh(
            label: "launch jobs",
            script: """#!/usr/bin/bash -x
source venv/bin/activate
python3 scripts/babeltrace-benchmark/benchmark.py \
  --check-regression-results \
  --bt-repo-path \$WORKSPACE/src/babeltrace
""",
          )
        }
      }
    }
  }

  post {
    always {
      dir('src/lttng-ci') {
        sh('rm -rf venv/')
      }
    }
  }
}

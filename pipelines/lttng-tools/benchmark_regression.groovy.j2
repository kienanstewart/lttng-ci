pipeline {
  agent {
    label 'deb13-amd64'
  }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 180, unit: 'MINUTES')
  }

  environment {
    BRANCH = "{{version}}"
    S3_HOST = "${params.S3_HOST}"
    S3_BUCKET = "${params.S3_BUCKET}"
    S3_BASE_DIR = "${params.S3_BASE_DIR}"
    S3_HTTP_BUCKET_URL = "${params.S3_HTTP_BUCKET_URL}"
  }

  stages {
    stage('Build kernel') {
      steps {
        build(
          job: 'system_tests_build_kernel_and_modules',
          parameters: [
            string(name: 'BUILD_DEVICE', value: 'baremetal'),
            string(name: 'KERNEL_COMMIT_ID', value: "${params.KERNEL_COMMIT_ID}"),
            string(name: 'LTTNG_MODULES_COMMIT_ID', value: '0be94330d9e0bd2f6fffa4c54ece0677a9a64b59'),
          ]
        )
      }
    }

    stage('Setup') {
      steps {
        cleanWs()

        dir('src/lttng-tools') {
          checkout([$class: 'GitSCM', branches: [[name: "{{version}}"]], userRemoteConfigs: [[url: "${params.LTTNG_TOOLS_REPO}"]]])
        }

        dir('src/lttng-ci') {
          checkout([$class: 'GitSCM', branches: [[name: "${params.LTTNG_CI_BRANCH}"]], userRemoteConfigs: [[url: "${params.LTTNG_CI_REPO}"]]])

          sh(
            label: 'Setup venv',
            script: """#!/usr/bin/bash -x
rm -rf venv/
python3 -m virtualenv venv
source venv/bin/activate
pip3 install -r scripts/lttng-tools-benchmarks/requirements.txt
""",
          )
        }
      }
    }

    stage('Launch LAVA job(s)') {
      when {
        expression {
          env.BENCHMARK_SKIP_SUBMISSION != "true"
        }
      }

      environment {
        LAVA2_JENKINS_TOKEN = credentials('jenkins_lava2_key')
        S3_KEY = credentials('s3_obj_lava_key')
      }

      steps {
        sh('env')
        dir('src/lttng-ci') {
          sh(
            label: "launch jobs",
            script: """#!/usr/bin/bash -x
source venv/bin/activate
ARGS=(
  --repo-path=\$WORKSPACE/src/lttng-tools
  --branch {{version}}
  generate-jobs
  --batch-size \$BENCHMARK_BATCH_SIZE
  --max-batches \$BENCHMARK_MAX_BATCHES
  --regression
)

if [[ \$BENCHMARK_FORCE == "true" ]]; then
  ARGS+=("--force-jobs")
fi

if [[ "\$BENCHMARK_DRY_RUN" == "true" ]]; then
  ARGS+=(--dry-run)
fi

S3_BASE_DIR="${params.S3_BASE_DIR}" python3 ./scripts/lttng-tools-benchmarks/benchmark.py "\${ARGS[@]}"
""",
          )
        }
      }
    }

    stage('Compare result(s)') {
      steps {
        dir('src/lttng-ci') {
          sh(
            label: "launch jobs",
            script: """#!/usr/bin/bash -x
source venv/bin/activate
regressions=0
S3_BASE_DIR="${params.S3_BASE_DIR}" python3 scripts/lttng-tools-benchmarks/benchmark.py \
  --repo-path=\$WORKSPACE/src/lttng-tools \
  changepoints \
  --regression \
  --output-format json \
  --output-path "\$WORKSPACE/changepoints.json" || regressions=1

S3_BASE_DIR="${params.S3_BASE_DIR}" python3 scripts/lttng-tools-benchmarks/benchmark.py \
  --repo-path=\$WORKSPACE/src/lttng-tools \
  changepoints \
  --regression \
  --output-format tsv \
  --output-path "\$WORKSPACE/changepoints.tsv" || regressions=1

if [[ \$regressions != "0" ]]; then
   echo "Regressions detected" >&2
   cat \$WORKSPACE/changepoints.json
fi

exit \$regressions
""",
          )
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts(artifacts: "changepoints.*")
      dir('src/lttng-ci') {
        sh('rm -rf venv/')
      }
    }
  }
}

pipeline {
  agent {
    label 'deb13-amd64'
  }

  environment {
    PROJECT_NAME = 'lttng-ci'
  }

  options {
    ansiColor('xterm')
    skipDefaultCheckout()
    preserveStashes()
    timestamps()
  }

  stages {
    stage('Checkout') {
      steps {
        cleanWs()
        dir('src/lttng-ci') {
          checkout([$class: 'GitSCM', branches: [[name: "${params.GIT_BRANCH}"]], userRemoteConfigs: [[url: "${params.GIT_URL}"]]])
        }
      }
    }

    stage('Fetch gerrit') {
      when {
        expression {
          env.GERRIT_PROJECT == "lttng-ci"
        }
      }

      steps {
        dir('src/lttng-ci') {
          sh(
            label: 'fetch gerrit changeset',
            script: '''#!/usr/bin/bash -x
git fetch "https://${GERRIT_HOST}/${GERRIT_PROJECT}" "${GERRIT_REFSPEC}"
git checkout FETCH_HEAD
''',
          )
        }
      }
    }

    stage('Setup') {
      steps {
        dir('src/lttng-ci/automation/bats') {
          sh(
            label: 'poetry',
            script: '''#!/usr/bin/bash -x
python3 -m virtualenv $WORKSPACE/venv/
source $WORKSPACE/venv/bin/activate
pip3 install poetry
poetry install
''',
          )
        }
      }
    }

    stage('Lint') {
      steps {
        dir('src/lttng-ci/automation/bats') {
          catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
            sh(
              label: 'black',
              script: '''#!/usr/bin/bash -x
source $WORKSPACE/venv/bin/activate
poetry run black --check --diff .
''',
            )
          }

          catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
            sh(
              label: 'isort',
              script: '''#!/usr/bin/bash -x
source $WORKSPACE/venv/bin/activate
poetry run isort --check --diff .
''',
            )
          }
        }
      }
    }

    stage('Test') {
      steps {
        dir('src/lttng-ci/automation/bats') {
          catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
            sh(
              label: 'pytest',
              script: '''#!/usr/bin/bash -x
source $WORKSPACE/venv/bin/activate
poetry run pytest -vv -rA --capture=tee-sys --tb=long --color=no \
  --log-cli-level=INFO -o log_level=INFO \
  --junit-xml="${WORKSPACE}/results.xml" \
  -o junit_logging=all \
  -o junit_log_passing_tests=true \
  -o junit_family=xunit2 \
'''
            )
          }
        }
      }

      post {
        always {
          archiveArtifacts(artifacts: "results.xml")
          junit("results.xml")
        }
      }
    }

    stage('Build') {
      steps {
        dir('src/lttng-ci/automation/bats') {
          sh(
            script: '''#!/usr/bin/bash -x
source $WORKSPACE/venv/bin/activate
poetry build
''',
          )

          archiveArtifacts(artifacts: "dist/**")
        }
      }
    }

    stage('Deploy') {
      when {
        expression {
          params.DEPLOY && params.DEPLOY_ENV != ""
        }
      }

      steps {
        echo('Not implemented')
      }
    }
  }
}
